# Zugangsdaten. Nach .env kopieren und ausfüllen; .env wird nicht eingecheckt.

# API-Token der Pushover-Anwendung, anzulegen unter https://pushover.net/apps/build
PUSHOVER_TOKEN=

# Dein User-Key (oder ein Group-Key) aus dem Pushover-Dashboard
PUSHOVER_USER=

# Optional: nur an ein bestimmtes Gerät senden
#PUSHOVER_DEVICE=

# Kontakt für den User-Agent: eine URL oder E-Mail-Adresse. Planespotters.net
# (Fotos) und airplanes.live lehnen Anfragen ohne Kontakt ab. Ohne Angabe
# kommen Pushes ohne Foto.
RAREBIRDALERT_CONTACT=

# Optional: OpenSky-Zugang (OAuth2-Client aus dem OpenSky-Konto). Ohne Angabe
# wird OpenSky anonym mit 400 statt 4000 Credits am Tag abgefragt.
#OPENSKY_CLIENT_ID=
#OPENSKY_CLIENT_SECRET=
