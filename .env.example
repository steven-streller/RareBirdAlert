# Copy to .env and fill in. docker-compose.yml reads this automatically.

# Secret used to sign session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If left empty, a random key is generated on every container start, which
# logs everyone out whenever the container restarts/redeploys.
SESSION_SECRET_KEY=

# Set to false once everyone who should have an account has registered, to
# stop anyone else from signing up. Existing accounts can still log in.
REGISTRATION_ENABLED=true

# Optional OpenSky Network OAuth2 client credentials (register a free
# account + API client at https://opensky-network.org/) for a much higher
# request quota than anonymous access. Leave empty to use OpenSky
# anonymously with the default (low) rate limit.
#
# These can also be set later in the web UI under Einstellungen ->
# Datenquellen. Whichever is set here always wins over the UI - if you set
# these env vars, the corresponding settings fields are shown locked/
# read-only so a change in the UI can't silently have no effect.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# adsb.lol (a second, complementary data source - see docs/data-sources.md)
# needs no credentials at all, so there's nothing to configure here for it.
